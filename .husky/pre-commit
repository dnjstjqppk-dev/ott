#!/usr/bin/env sh
set -e

echo "[GATE 1] Checking for forbidden mock/placeholder keywords..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '^(\.husky/|.*_grpc\.pb\.go$|.*\.pb\.go$|.*/internal/db/sqlc/|.*go\.sum$|.*package-lock\.json$)' || true)

if [ -n "$STAGED_FILES" ]; then
  if grep -rnHEi "(TODO|FIXME|mockData|dummyData|sampleData|\/\/\s*\.\.\.)" $STAGED_FILES; then
    echo "FATAL: Forbidden placeholder, TODO, or mock keyword detected. Commit rejected."
    exit 1
  fi

  echo "[GATE 2] Checking strict 250-line limit per file..."
  for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
      LINES=$(wc -l < "$FILE" | tr -d ' ')
      if [ "$LINES" -gt 250 ]; then
        echo "FATAL: $FILE has $LINES lines (exceeds maximum limit of 250 lines). Split the module."
        exit 1
      fi
    fi
  done
fi

echo "[GATE 3] Running Go static analysis..."
if [ -d "services" ]; then
  for SVC in services/*/; do
    if [ -f "${SVC}go.mod" ]; then
      (cd "$SVC" && go vet ./...)
    fi
  done
fi

echo "[SUCCESS] All pre-commit governance gates passed."
