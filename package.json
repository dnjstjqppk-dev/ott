{
  "name": "netflix-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Global OTT Netflix Full-Stack Clone Ecosystem",
  "workspaces": [
    "clients/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build:web-user",
    "build:web-user": "npm run build --workspace=clients/web-user",
    "build:web-admin": "npm run build --workspace=clients/web-admin",
    "build:web-studio": "npm run build --workspace=clients/web-studio-partner",
    "build:all": "npm run build --workspaces --if-present",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "wrangler": "^4.152.0"
  }
}
